# Copy values into apps/api/.env and apps/web/.env.local as needed.

# --- Postgres (psql / migrations use a libpq URL; API uses asyncpg) ---
DATABASE_URL_PSQL=postgresql://postgres:postgres@localhost:5432/ahoy
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ahoy

# --- API ---
JWT_SECRET=dev-change-me-ahoy-jwt-secret
AUTH_DEV_MODE=true
SHIP_APP_BASE_URL=http://localhost:3000
CREW_APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- LLM / Milestone B ---
LLM_DEV_MODE=true
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
UPLOAD_DIR=uploads
PUBLIC_API_BASE_URL=http://localhost:8000

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
