ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ahoy
JWT_SECRET=dev-change-me-ahoy-jwt-secret
JWT_TTL_HOURS=48
MAGIC_LINK_TTL_MINUTES=30
AUTH_DEV_MODE=true
SHIP_APP_BASE_URL=http://localhost:3000
CREW_APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Notifications (0.8.0) ---
# SMS is sent only when TWILIO_* are set AND AUTH_DEV_MODE=false; otherwise logged.
NOTIFY_LINK_TTL_HOURS=48
QUEUE_REMINDER_HOURS_BEFORE=48
# Push via Firebase Cloud Messaging HTTP v1 (iOS / Android / web). Leave blank to skip push.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# --- Publishing + worker (0.9.0) ---
# Ayrshare Business API key (per-client profile keys are entered in Crew -> Client settings).
AYRSHARE_API_KEY=
PUBLISH_MAX_ATTEMPTS=3
# Encrypts per-client integration secrets at rest. Use a long random value in production.
CREDENTIALS_ENCRYPTION_KEY=dev-change-me-ahoy-credentials-key
# true = run the job loop inside the API process; otherwise run `uv run python -m app.worker`.
EMBEDDED_WORKER=false

# --- Reviews (0.11.0) ---
# Google OAuth app (Business Profile APIs enabled; scope business.manage). Register the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
# Yelp Fusion API key (read-only review excerpts)
YELP_API_KEY=

# --- Billing (0.13.0) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly price ids for the three tiers
STRIPE_PRICE_HARBOR=
STRIPE_PRICE_CRUISER=
STRIPE_PRICE_FLAGSHIP=

# --- Observability (0.15.0) ---
LOG_FORMAT=text
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
LLM_DEV_MODE=true
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
UPLOAD_DIR=uploads
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# File storage (1.2.0). Production: supabase (bucket must be public).
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=ahoy-media
